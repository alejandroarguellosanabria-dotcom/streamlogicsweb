---
import "@fontsource-variable/inter";
import "../styles/global.css";

const {
  title = "streamlogics — Clip Agency for Streamers",
  description = "We turn your Twitch VODs into vertical clips for TikTok, Shorts and Reels. Send one link, get clips ready to post. Every clip picked and reviewed by a human.",
} = Astro.props;
const url = "https://streamlogicsweb.com/";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#ffffff" />
  <script is:inline>
    document.documentElement.classList.add("js");
    // Modo claro u oscuro: lo que eligio la persona, o el de su sistema mientras no elija
    (function () {
      var m = null;
      try { m = localStorage.getItem("sl-theme"); } catch (e) {}
      if (m !== "light" && m !== "dark") m = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      document.documentElement.dataset.theme = m;
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="canonical" href={url} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="streamlogics" />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content="We turn your Twitch VODs into vertical clips for TikTok, Shorts and Reels. Send one link, get clips ready to post." />
  <meta property="og:image" content="https://streamlogicsweb.com/favicon-512.png" />
  <meta name="twitter:card" content="summary" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "ProfessionalService", name: "streamlogics", url,
    logo: "https://streamlogicsweb.com/favicon-512.png", email: "contacto@streamlogicsweb.com",
    description: "Clip agency for streamers: we turn Twitch VODs into vertical clips for TikTok, YouTube Shorts and Instagram Reels.",
    areaServed: "Worldwide", serviceType: "Video clip editing for streamers",
  })} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
</head>
<body>
  <slot />
</body>
</html>
