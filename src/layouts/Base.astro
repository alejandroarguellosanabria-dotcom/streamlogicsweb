---
import "@fontsource-variable/inter";
import "../styles/global.css";
import { T } from "../i18n.js";

const { lang = "en", t = T.en } = Astro.props;
const title = t.meta_title, description = t.meta_desc;
const url = "https://streamlogicsweb.com/";
// Cada idioma en su URL; el ingles en la raiz (y es el de reserva, x-default)
const LANG_URL = { en: url, es: url + "es/", pt: url + "pt/", fr: url + "fr/" };
const here = LANG_URL[lang];
const LOCALE = { en: "en_US", es: "es_ES", pt: "pt_BR", fr: "fr_FR" };
const logo = "https://streamlogicsweb.com/favicon-512.png?v=2";
const about = "streamlogics is a short-form content agency. We turn long videos (streams, podcasts, YouTube videos, interviews, classes) into vertical clips for TikTok, YouTube Shorts and Instagram Reels. A real person picks, edits and reviews every clip. One-time packages, no subscription.";
const plain = (h) => h.replace(/<[^>]+>/g, "");
// Datos para Google y asistentes de IA: quien es la empresa, que hace y sus preguntas frecuentes.
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": url + "#org", name: "streamlogics", alternateName: ["StreamLogics", "streamlogicsweb"],
      url, logo, email: "contacto@streamlogicsweb.com", description: about, slogan: "Every clip edited and reviewed by a real person.",
      knowsLanguage: ["en", "es", "pt", "fr"], areaServed: "Worldwide" },
    { "@type": "WebSite", "@id": url + "#site", name: "streamlogics", url, publisher: { "@id": url + "#org" }, inLanguage: ["en", "es", "pt", "fr"] },
    { "@type": "ProfessionalService", "@id": url + "#service", name: "streamlogics", url, image: logo, email: "contacto@streamlogicsweb.com",
      description: about, areaServed: "Worldwide", parentOrganization: { "@id": url + "#org" },
      serviceType: "Short-form video editing and content creation agency",
      knowsAbout: ["short-form video", "video clipping", "TikTok", "YouTube Shorts", "Instagram Reels", "podcast clips", "stream clips", "captions", "content creation"] },
    { "@type": "FAQPage", "@id": here + "#faq", inLanguage: lang, mainEntity: [6, 7, 1, 2, 3, 4, 5].map((n) => (
      { "@type": "Question", name: t["q" + n], acceptedAnswer: { "@type": "Answer", text: plain(t["a" + n]) } })) },
  ],
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#ffffff" />
  <script is:inline>
    document.documentElement.classList.add("js");
    // Modo claro u oscuro: lo que eligio la persona, o el de su sistema mientras no elija
    (function () {
      var m = null;
      try { m = localStorage.getItem("sl-theme"); } catch (e) {}
      if (m !== "light" && m !== "dark") m = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      document.documentElement.dataset.theme = m;
    })();
  </script>
  {lang === "en" && <script is:inline>
    // En la raiz (ingles): quien llega con otro idioma va a su URL (/es/, /pt/, /fr/).
    // Manda, por orden: ?lang=, el idioma elegido a mano antes, el del navegador.
    (function () {
      var L = ["en", "es", "pt", "fr"], want = new URLSearchParams(location.search).get("lang"), saved = null;
      try { saved = localStorage.getItem("sl-lang"); } catch (e) {}
      if (L.indexOf(want) < 0) want = L.indexOf(saved) >= 0 ? saved : null;
      if (!want) {
        var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || "en"];
        for (var i = 0; i < prefs.length && !want; i++) for (var j = 0; j < L.length; j++) if (String(prefs[i]).toLowerCase().indexOf(L[j]) === 0) { want = L[j]; break; }
      }
      if (want && want !== "en") location.replace("/" + want + "/" + location.hash);
    })();
  </script>}
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large" />

  <link rel="canonical" href={here} />
  {Object.entries(LANG_URL).map(([l, u]) => <link rel="alternate" hreflang={l} href={u} />)}
  <link rel="alternate" hreflang="x-default" href={url} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="streamlogics" />
  <meta property="og:url" content={here} />
  <meta property="og:locale" content={LOCALE[lang]} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://streamlogicsweb.com/favicon-512.png?v=2" />
  <meta name="twitter:card" content="summary" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="streamlogics for AI assistants" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=2" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png?v=2" />
</head>
<body>
  <slot />
</body>
</html>
